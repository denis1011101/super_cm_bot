BOT_TOKEN=your_bot_token_here
SPECIFIC_CHAT_ID=group_chat_id
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: primary model (defaults to gemini-3.7-flash).
# When unset or set to a model from the pool, the bot automatically walks the pool
# (gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite)
# starting at GEMINI_MODEL and rotating around.
# A custom model outside the pool remains a single-model chain unless GEMINI_FALLBACK_MODEL is set.
# GEMINI_MODEL=gemini-3.7-flash
# Optional: comma-separated fallback models. When unset, defaults to the rotated pool above.
# Set GEMINI_FALLBACK_MODEL= (empty) to completely disable fallbacks.
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.5-flash

# --- agent bus (MCP) ---
# Address for the shared status board other bots connect to. Leave unset to
# disable it entirely; the bot then behaves exactly as before.
# Bearer tokens cross the network in clear, so bind loopback and put a TLS
# proxy in front, or terminate TLS ahead of it.
MCP_ADDR=127.0.0.1:8765
# One bot:token pair per participant, comma separated. Tokens are at least 24
# characters, unique per bot, and identify the caller: a bot can only publish
# its own status.
MCP_TOKENS=peer_bot:replace_with_a_long_random_token
# Name this bot publishes under. Defaults to its Telegram username.
MCP_SELF=
